# Block demographics use the official Census of India Village Amenities 2011
# district CSVs catalogued at data.gov.in under catalog UUID
# 007f2c63-cdb1-4c91-82ef-61716f0b0e76. The catalog has no consumable row API,
# so no data.gov.in key is accepted or required. Each selected district's exact
# resource UUID is resolved, verified, and returned in result provenance.
VYAPARSATHI_CENSUS_DATA_TIMEOUT_SECONDS=45
VYAPARSATHI_CENSUS_DISTRICT_CACHE_TTL_SECONDS=2592000
# Optional developer/offline fallback: a file downloaded from the exact
# data.gov.in resource URL. Leave empty in production so live retrieval is
# required. The application never accepts an arbitrary CSV as evidence.
VYAPARSATHI_CENSUS_LOCAL_CACHE_DIR=

# Regional purchasing capacity uses the reviewed MoSPI HCES 2023-24 rural MPCE
# table, data.gov.in resource UUID 89bf5d50-cecf-4219-84d9-12b062c301e2. The
# application calculates state rural MPCE / All-India rural MPCE for every
# supported category. It never configures a generic market-price API or claims
# an observed local price. No API key is used.

# OpenStreetMap's public Overpass endpoint is used for administrative-boundary,
# mapped-business, and commercial-activity queries. Override only with a
# compliant HTTPS Overpass deployment.
VYAPARSATHI_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Optional: used only when the default public instance is unavailable.
VYAPARSATHI_OVERPASS_FALLBACK_URL=https://overpass.kumi.systems/api/interpreter
VYAPARSATHI_BLOCK_ADMIN_LEVELS=6,7
VYAPARSATHI_PUBLIC_DATA_TIMEOUT_SECONDS=30
VYAPARSATHI_OSM_FEATURE_TIMEOUT_SECONDS=20
# Administrative dropdowns use a short, separate public-source timeout. A
# successful live result is cached in-process (state 7d, district 1d, block 6h)
# and in the browser session; no demo administrative records are substituted.
VYAPARSATHI_ADMIN_DATA_TIMEOUT_SECONDS=5
VYAPARSATHI_STATE_ADMIN_CACHE_TTL_SECONDS=604800
VYAPARSATHI_DISTRICT_ADMIN_CACHE_TTL_SECONDS=86400
VYAPARSATHI_BLOCK_ADMIN_CACHE_TTL_SECONDS=21600
VYAPARSATHI_HTTP_USER_AGENT=VyaparSathi/1.0 (contact: replace-with-support-email)

# Optional provider fallbacks. Keep real keys only in backend/.env; never expose
# the server-side key through Vite or commit it to source control.
GOOGLE_MAPS_API_KEY=
VYAPARSATHI_GOOGLE_PLACES_API_KEY=
GEOAPIFY_API_KEY=
OPENROUTESERVICE_API_KEY=
GEMINI_API_KEY=
VYAPARSATHI_GOOGLE_MAPS_ENABLED=false
VYAPARSATHI_LOCAL_OSM_SNAPSHOT_ENABLED=false
VYAPARSATHI_LIVE_PLACE_PROVIDERS_ENABLED=false
VYAPARSATHI_MULTISOURCE_COMPETITORS_ENABLED=false
VYAPARSATHI_OPENROUTESERVICE_ENABLED=false
